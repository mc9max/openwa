# OpenWA — Railway template defaults
# Only the vars that change behaviour on a fresh one-click deploy. Everything
# else is optional and defaults sanely in the app (see .env.example upstream).

NODE_ENV=production
PORT=2785
TZ=UTC

# Data store. SQLite is the zero-config default and lives on the
# openwa-data volume at /app/data. To use PostgreSQL instead, set
# DATABASE_TYPE=postgres plus DATABASE_HOST / DATABASE_PORT /
# DATABASE_USERNAME / DATABASE_PASSWORD (and optionally DATABASE_NAME /
# POSTGRES_SCHEMA) — typically a sibling Postgres service in this project.
DATABASE_TYPE=sqlite

# Admin API key — RECOMMENDED: set this once before first boot.
# OpenWA uses it verbatim as the default ADMIN key (32+ chars in production).
# Leave blank and OpenWA instead generates a random owa_k1_<hex> and prints it
# once to the first-boot logs (persisted to /app/data/.api-key).
#
#   API_MASTER_KEY=***
#
# Only takes effect on the very first boot (empty api_keys table). After that,
# rotate in the dashboard — changing this env var has no further effect.
# API_KEY_PEPPER=           # optional: HMAC-peppered key hashing (set before first boot)

# Base URL of the instance, used in outbound payloads and callbacks.
# BASE_URL=                 # e.g. https://openwa-xyz.up.railway.app

# Interactive Swagger docs on /api/docs (off by default; enable if you want it)
# ENABLE_SWAGGER=true

# Reconnect previously paired WhatsApp sessions automatically on restart
# AUTO_START_SESSIONS=true
